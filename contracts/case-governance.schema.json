{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "病例治理",
  "description": "病例贡献者的授权范围、再识别风险评估与盲审利益冲突控制。",
  "type": "object",
  "required": [
    "case_id",
    "contributor",
    "consent",
    "deidentification",
    "reidentification_risk",
    "blind_review"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "脱敏病例编号"
    },
    "contributor": {
      "type": "string",
      "description": "病例贡献方"
    },
    "consent": {
      "type": "object",
      "required": ["scope", "granted_at", "expires_at", "revocable", "withdrawn"],
      "description": "授权信息，病例仅可在授权范围内使用",
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["pre_consultation", "outpatient_record", "imaging_review", "mdt", "follow_up", "benchmark_validation"]
          },
          "description": "授权使用范围"
        },
        "granted_at": {
          "type": "string",
          "format": "date",
          "description": "授权签署日期"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date",
          "description": "授权到期日期"
        },
        "revocable": {
          "type": "boolean",
          "description": "是否可撤销"
        },
        "withdrawn": {
          "type": "boolean",
          "description": "是否已撤销，撤销后不得进入新冻结题集"
        }
      },
      "additionalProperties": false
    },
    "deidentification": {
      "type": "object",
      "required": ["level", "method"],
      "properties": {
        "level": {
          "type": "string",
          "description": "脱敏级别"
        },
        "method": {
          "type": "string",
          "description": "脱敏方法"
        }
      },
      "additionalProperties": false
    },
    "reidentification_risk": {
      "type": "object",
      "required": ["rare_combination", "risk_level", "assessed_by", "assessed_at"],
      "description": "再识别风险评估，稀有组合必须评估并给出缓释措施",
      "properties": {
        "rare_combination": {
          "type": "boolean",
          "description": "是否含稀有特征组合"
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "assessed_by": {
          "type": "string",
          "description": "评估人标识"
        },
        "assessed_at": {
          "type": "string",
          "format": "date"
        },
        "mitigation": {
          "type": "string",
          "description": "缓释措施，风险为 medium 或 high 时必填"
        }
      },
      "additionalProperties": false
    },
    "blind_review": {
      "type": "object",
      "required": ["reviewers", "conflicts_of_interest"],
      "properties": {
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "参与盲审的专家标识"
        },
        "conflicts_of_interest": {
          "type": "array",
          "description": "利益冲突申报，申报后必须回避",
          "items": {
            "type": "object",
            "required": ["reviewer", "conflict", "action"],
            "properties": {
              "reviewer": {
                "type": "string"
              },
              "conflict": {
                "type": "string",
                "description": "冲突内容"
              },
              "action": {
                "type": "string",
                "enum": ["recused"],
                "description": "处理方式：回避"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
