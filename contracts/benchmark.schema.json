{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "基准冻结与验证运行",
  "description": "一次模型验证必须冻结完整题集与评分规则；失败重跑引用同一冻结集且不得挑换病例；运行结果记录能力边界与证据缺口。",
  "type": "object",
  "required": ["freezes", "runs"],
  "properties": {
    "freezes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["freeze_id", "created_at", "created_by", "items", "scoring_rules", "hash"],
        "properties": {
          "freeze_id": {
            "type": "string",
            "description": "冻结集唯一标识"
          },
          "created_at": {
            "type": "string",
            "format": "date"
          },
          "created_by": {
            "type": "string",
            "description": "冻结操作人"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "description": "冻结的题集，精确到决策点版本",
            "items": {
              "type": "object",
              "required": ["decision_point_id", "version"],
              "properties": {
                "decision_point_id": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "scoring_rules": {
            "type": "object",
            "required": ["rule_set_id", "pass_threshold", "dimensions"],
            "properties": {
              "rule_set_id": {
                "type": "string",
                "description": "评分规则集标识"
              },
              "pass_threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "dimensions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "评分维度"
              }
            },
            "additionalProperties": false
          },
          "hash": {
            "type": "string",
            "description": "冻结内容摘要，用于校验题集与评分规则未被改动"
          }
        },
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "freeze_id",
          "model",
          "parent_run_id",
          "started_at",
          "outcome",
          "capability_boundaries",
          "evidence_gaps"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "freeze_id": {
            "type": "string",
            "description": "引用的冻结集，重跑必须与父运行一致"
          },
          "model": {
            "type": "string",
            "description": "被验证的模型及版本"
          },
          "parent_run_id": {
            "type": ["string", "null"],
            "description": "失败重跑时指向父运行；题集不得因此更换"
          },
          "started_at": {
            "type": "string",
            "format": "date"
          },
          "outcome": {
            "type": "string",
            "enum": ["passed", "failed"]
          },
          "capability_boundaries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "向医生呈现的可解释能力边界"
          },
          "evidence_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "暴露出的证据缺口"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
