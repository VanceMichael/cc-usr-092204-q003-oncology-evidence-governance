{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "模型验证运行记录",
  "description": "一次验证冻结完整题集与评分规则；失败重跑必须复用同一冻结集，不得挑换病例；指南撤回后可据证据引用定位受影响结果。",
  "type": "object",
  "required": [
    "doc",
    "note",
    "runs"
  ],
  "properties": {
    "doc": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "model",
          "frozen_at",
          "frozen_item_set",
          "scoring_rules",
          "status",
          "rerun_of",
          "results"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^RUN-[A-Z0-9-]+$"
          },
          "model": {
            "type": "string",
            "description": "受验模型标识（含版本）"
          },
          "frozen_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "题集与评分规则冻结日期，冻结后不得修改"
          },
          "frozen_item_set": {
            "type": "array",
            "minItems": 1,
            "description": "冻结题集：决策点与版本的精确组合",
            "items": {
              "type": "object",
              "required": [
                "decision_id",
                "version"
              ],
              "properties": {
                "decision_id": {
                  "type": "string",
                  "pattern": "^CDP-[A-Z0-9-]+$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^v\\d+$"
                }
              },
              "additionalProperties": false
            }
          },
          "scoring_rules": {
            "type": "object",
            "required": [
              "version",
              "pass_threshold",
              "dimensions"
            ],
            "properties": {
              "version": {
                "type": "string",
                "description": "评分规则版本号"
              },
              "pass_threshold": {
                "type": "number",
                "description": "通过阈值（0-1）"
              },
              "dimensions": {
                "type": "array",
                "minItems": 1,
                "description": "评分维度",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "通过",
              "未通过",
              "已作废"
            ],
            "description": "已作废：所依据证据被撤回等原因导致结果不再可信"
          },
          "rerun_of": {
            "type": [
              "string",
              "null"
            ],
            "description": "若为重跑，指向原运行 run_id；重跑必须复用原冻结题集与评分规则"
          },
          "invalidation": {
            "type": [
              "object",
              "null"
            ],
            "description": "作废说明，仅 status 为已作废时填写",
            "required": [
              "reason",
              "trigger_evidence",
              "affected_items"
            ],
            "properties": {
              "reason": {
                "type": "string"
              },
              "trigger_evidence": {
                "type": "array",
                "minItems": 1,
                "description": "触发作废的证据条目（如被撤回的指南条款）",
                "items": {
                  "type": "string",
                  "pattern": "^EV-[A-Z0-9-]+$"
                }
              },
              "affected_items": {
                "type": "array",
                "minItems": 1,
                "description": "受影响的冻结题目",
                "items": {
                  "type": "string",
                  "pattern": "^CDP-[A-Z0-9-]+$"
                }
              }
            },
            "additionalProperties": false
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "description": "逐题结果；任何结论可追溯到当时有效的病例、规则与审签",
            "items": {
              "type": "object",
              "required": [
                "decision_id",
                "version",
                "model_answer",
                "expected_answer",
                "correct",
                "explanation"
              ],
              "properties": {
                "decision_id": {
                  "type": "string",
                  "pattern": "^CDP-[A-Z0-9-]+$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^v\\d+$"
                },
                "model_answer": {
                  "type": "string"
                },
                "expected_answer": {
                  "type": "string"
                },
                "correct": {
                  "type": "boolean"
                },
                "explanation": {
                  "type": "string",
                  "description": "评分说明，呈现能力边界或证据缺口"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
